---
type Name =
  | "github"
  | "x"
  | "linkedin"
  | "instagram"
  | "spotify"
  | "mail"
  | "arrow"
  | "arrow-left"
  | "sun"
  | "moon"
  | "rss"
  | "globe"
interface Props {
  name: Name
  size?: number
  class?: string
}
const { name, size = 18, class: className } = Astro.props
const filled = ["github", "x", "linkedin", "instagram", "spotify"].includes(name)
---

