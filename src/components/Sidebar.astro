---
import Icon from "@/components/Icon.astro"
import Logo from "@/components/Logo.astro"
import type { Locale } from "@/data/types"
import { t } from "@/i18n/ui"
import { isCurrent, localizedPath, otherLocale } from "@/lib/paths"

interface Props {
  locale: Locale
  path: string
}
const { locale, path } = Astro.props
const here = localizedPath(locale, path)
const items = [
  { href: localizedPath(locale, "/blog/"), label: t(locale, "blog") },
  { href: localizedPath(locale, "/work/"), label: t(locale, "work") },
  { href: localizedPath(locale, "/plan/"), label: t(locale, "plan") },
  { href: localizedPath(locale, "/about/"), label: t(locale, "about") },
]
const other = otherLocale(locale)
---

<aside class="side">
  <div class="side-inner">
    <a class="brand" href={localizedPath(locale, "/")} aria-label="shai.biz">
      <Logo />
      <span class="wm">shai<span>.biz</span></span>
    </a>
    <nav aria-label={t(locale, "nav")}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(here, item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <a class="tool lang" href={localizedPath(other, path)} hreflang={other} lang={other} title={t(locale, "langSwitch")}>
        {t(locale, "langShort")}
      </a>
      <button class="tool" type="button" data-theme-toggle aria-label={t(locale, "theme")} title={t(locale, "theme")}>
        <Icon name="sun" size={16} class="i-sun" />
        <Icon name="moon" size={16} class="i-moon" />
      </button>
    </div>
  </div>
</aside>

<style>
  .side {
    position: relative;
  }
  .side-inner {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 36px 24px 28px 28px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    font-weight: 600;
    font-size: 15px;
    padding: 2px 0;
    letter-spacing: -0.01em;
    width: fit-content;
  }
  .wm span {
    color: var(--muted);
    font-weight: 400;
  }
  nav ul {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 6px 0;
    color: var(--ink-2);
    font-size: 15px;
    transition:
      color 0.2s,
      transform 0.3s var(--ease);
  }
  nav a::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--accent);
    margin-right: 0;
    transform: scale(0);
    width: 0;
    transition:
      transform 0.3s var(--ease),
      width 0.3s var(--ease),
      margin 0.3s var(--ease);
  }
  nav a:hover {
    color: var(--ink);
    transform: translateX(2px);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  nav a[aria-current="page"]::before {
    transform: scale(1);
    width: 6px;
    margin-right: 10px;
  }
  .tools {
    margin-top: auto;
    display: flex;
    gap: 6px;
  }
  .tool {
    height: 32px;
    min-width: 32px;
    padding: 0 8px;
    display: inline-grid;
    place-items: center;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--tile);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }
  .tool:hover {
    border-color: var(--line-strong);
    color: var(--accent-ink);
  }
  .tool :global(.i-moon) {
    display: none;
  }
  :global([data-theme="dark"]) .tool :global(.i-sun) {
    display: none;
  }
  :global([data-theme="dark"]) .tool :global(.i-moon) {
    display: block;
  }

  @media (max-width: 860px) {
    .side {
      position: sticky;
      top: 0;
      z-index: 20;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      backdrop-filter: blur(14px) saturate(1.4);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      border-bottom: 1px solid var(--line);
    }
    .side-inner {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: 6px;
      padding: 10px 16px;
    }
    .brand .wm {
      display: none;
    }
    nav {
      flex: 1;
    }
    nav ul {
      margin: 0 0 0 14px;
      display: flex;
      gap: clamp(10px, 3.4vw, 18px);
    }
    nav a {
      padding: 6px 0;
      font-size: 14.5px;
      white-space: nowrap;
    }
    nav a::before {
      display: none;
    }
    nav a[aria-current="page"] {
      box-shadow: inset 0 -2px 0 var(--accent);
    }
    .tools {
      margin: 0;
    }
  }
</style>
