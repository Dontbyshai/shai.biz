<style>
  .scene {
    width: 100%;
    height: 100%;
  }
  .s-sky { fill: var(--scene-sky); }
  .s-sun { fill: var(--scene-sun); }
  .s-far { fill: var(--scene-far); }
  .s-mid { fill: var(--scene-mid); }
  .s-near { fill: var(--scene-near); }
  .s-trees { fill: var(--scene-front); }
  .s-front { fill: var(--scene-front); }
  .s-mast path { stroke: var(--scene-mid); stroke-width: 1.6; fill: none; stroke-linecap: round; }
  .s-blink { fill: var(--accent); }
  .s-cloud { fill: color-mix(in srgb, var(--tile) 80%, transparent); }
  .s-stars { fill: var(--scene-sun); opacity: 0; }
  :global([data-theme="dark"]) .s-stars { opacity: 0.8; }
  :global([data-theme="dark"]) .s-clouds { opacity: 0.12; }
  :global([data-theme="dark"]) .s-mast path { stroke: #4a4550; }
  @media (prefers-reduced-motion: no-preference) {
    .c1 { animation: drift 38s linear infinite alternate; }
    .c2 { animation: drift 52s linear infinite alternate-reverse; }
    .s-blink { animation: blink 2.2s steps(1) infinite; }
    .s-stars circle:nth-child(odd) { animation: twinkle 3.5s ease-in-out infinite; }
  }
  @keyframes drift { from { transform: translateX(-30px); } to { transform: translateX(60px); } }
  @keyframes blink { 50% { opacity: 0.15; } }
  @keyframes twinkle { 50% { opacity: 0.3; } }
</style>
