<style>
  .scene { width: 100%; height: 100%; }
  .st-sky-top { stop-color: var(--scene-sky-top); }
  .st-sky { stop-color: var(--scene-sky); }
  .st-glow { stop-color: var(--scene-sun); }
  .st-mist { stop-color: var(--scene-sky); }
  .s-sun { fill: var(--scene-sun); }
  .s-far { fill: var(--scene-far); }
  .s-midfar { fill: var(--scene-midfar); }
  .s-mid { fill: var(--scene-mid); }
  .s-near { fill: var(--scene-near); }
  .s-forest { fill: var(--scene-forest); }
  .s-front { fill: var(--scene-front); }
  .s-big { fill: var(--scene-big); }
  .s-road { fill: none; stroke: var(--scene-near); stroke-width: 3; stroke-linecap: round; opacity: 0.7; }
  .s-mast path { stroke: var(--scene-mast); stroke-width: 1.8; fill: none; stroke-linecap: round; }
  .s-blink { fill: var(--accent); }
  .s-clouds path { fill: var(--scene-cloud); }
  .s-birds path { fill: none; stroke: var(--scene-near); stroke-width: 1.4; stroke-linecap: round; }
  .s-stars { fill: var(--scene-sun); opacity: 0; transition: opacity 0.6s; }
  :global([data-theme="dark"]) .s-stars { opacity: 0.85; }
  :global([data-theme="dark"]) .s-birds { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .c1 { animation: drift 46s linear infinite alternate; }
    .c2 { animation: drift 60s linear infinite alternate-reverse; }
    .s-birds { animation: fly 26s linear infinite; }
    .s-blink { animation: blink 2.2s steps(1) infinite; }
    .s-stars circle:nth-child(3n) { animation: twinkle 3.2s ease-in-out infinite; }
    .s-stars circle:nth-child(5n) { animation: twinkle 4.4s ease-in-out infinite reverse; }
  }
  @keyframes drift { from { transform: translateX(-40px); } to { transform: translateX(70px); } }
  @keyframes fly { from { transform: translate(60px, 10px); } to { transform: translate(-700px, -30px); } }
  @keyframes blink { 50% { opacity: 0.15; } }
  @keyframes twinkle { 50% { opacity: 0.25; } }
</style>
