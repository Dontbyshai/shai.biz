---
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
import ArrowUpRight from "@/assets/icons/arrow-up-right.svg"
import GitHubIcon from "@/assets/icons/github.svg"
import BookIcon from "@/assets/icons/book-open-text.svg"
import BriefcaseIcon from "@/assets/icons/briefcase.svg"
import EmailIcon from "@/assets/icons/email.svg"
import LinkedinIcon from "@/assets/icons/linkedin.svg"
import TwitterIcon from "@/assets/icons/twitter.svg"
import ABackgroundMobileDark from "@/assets/bento/a-background-mobile-dark.svg"
import ABackgroundMobileLight from "@/assets/bento/a-background-mobile-light.svg"
import ABackgroundDark from "@/assets/bento/a-background-dark.svg"
import ABackgroundLight from "@/assets/bento/a-background-light.svg"
import AForegroundMobileDark from "@/assets/bento/a-foreground-mobile-dark.svg"
import AForegroundMobileLight from "@/assets/bento/a-foreground-mobile-light.svg"
import AForegroundDark from "@/assets/bento/a-foreground-dark.svg"
import AForegroundLight from "@/assets/bento/a-foreground-light.svg"
import BBackgroundDark from "@/assets/bento/b-background-dark.svg"
import BBackgroundLight from "@/assets/bento/b-background-light.svg"
import BForegroundDark from "@/assets/bento/b-foreground-dark.svg"
import BForegroundLight from "@/assets/bento/b-foreground-light.svg"
import CImageDark from "@/assets/bento/c-dark.svg"
import CImageLight from "@/assets/bento/c-light.svg"
import EBackgroundMobileDark from "@/assets/bento/e-background-mobile-dark.svg"
import EBackgroundMobileLight from "@/assets/bento/e-background-mobile-light.svg"
import EBackgroundDark from "@/assets/bento/e-background-dark.svg"
import EBackgroundLight from "@/assets/bento/e-background-light.svg"
import EForegroundMobileDark from "@/assets/bento/e-foreground-mobile-dark.svg"
import EForegroundMobileLight from "@/assets/bento/e-foreground-mobile-light.svg"
import EForegroundDark from "@/assets/bento/e-foreground-dark.svg"
import EForegroundLight from "@/assets/bento/e-foreground-light.svg"
import FBackgroundDark from "@/assets/bento/f-background-dark.svg"
import FBackgroundLight from "@/assets/bento/f-background-light.svg"
import FForegroundDark from "@/assets/bento/f-foreground-dark.svg"
import FForegroundLight from "@/assets/bento/f-foreground-light.svg"
import GBackgroundDark from "@/assets/bento/g-background-dark.svg"
import GBackgroundLight from "@/assets/bento/g-background-light.svg"
import GForegroundDark from "@/assets/bento/g-foreground-dark.svg"
import GForegroundLight from "@/assets/bento/g-foreground-light.svg"
import HImageDark from "@/assets/bento/h-dark.svg"
import HImageLight from "@/assets/bento/h-light.svg"
import IBackgroundDark from "@/assets/bento/i-background-dark.svg"
import IBackgroundLight from "@/assets/bento/i-background-light.svg"
import IForegroundDark from "@/assets/bento/i-foreground-dark.svg"
import IForegroundLight from "@/assets/bento/i-foreground-light.svg"
import KBackgroundDark from "@/assets/bento/k-background-dark.svg"
import KBackgroundLight from "@/assets/bento/k-background-light.svg"
import KForegroundDark from "@/assets/bento/k-foreground-dark.svg"
import KForegroundLight from "@/assets/bento/k-foreground-light.svg"

import ThemeToggle from "@/components/ThemeToggle.astro"
import GithubCalendar from "@/components/GithubCalendar.astro"
import MetaPage from "@/components/MetaPage.astro"
import ThemedBannerImage from "@/components/ThemedBannerImage.astro"

import { SOCIALS } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { bannerRaster } from "@/lib/assets/banner"
import { getPosts } from "@/lib/content"
import { Image } from "astro:assets"

const latestPost = (await getPosts()).at(0)
const latestPostRaster = latestPost ? bannerRaster(latestPost) : null
const githubHref = SOCIALS.find((link) => link.label === "GitHub")?.href ?? "#"
const twitterHref =
  SOCIALS.find((link) => link.label === "Twitter")?.href ?? "#"
---

<Layout wide>
  <MetaPage slot="head" />
  <bento-container>
    <bento-grid>
      <bento-cell style="grid-area: a">
        <bento-layer>
          <ABackgroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMid slice"
          />
          <ABackgroundLight
            data-theme-light
            preserveAspectRatio="xMidYMid slice"
          />
        </bento-layer>
        <bento-layer data-overlay>
          <AForegroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMid slice"
          />
          <AForegroundLight
            data-theme-light
            preserveAspectRatio="xMidYMid slice"
          />
          <bento-note-stack data-note="about" data-linebreak-root>
            <bento-note data-tail="left" set:html={t('note.about')} />
          </bento-note-stack>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: b" data-trigger>
        <bento-layer>
          <BBackgroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMid slice"
          />
          <BBackgroundLight
            data-theme-light
            preserveAspectRatio="xMidYMid slice"
          />
        </bento-layer>
        <bento-layer data-reveal>
          <BForegroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMid slice"
          />
          <BForegroundLight
            data-theme-light
            preserveAspectRatio="xMidYMid slice"
          />
          <bento-note data-note="details" data-tail="right">
            <strong>{t('note.details.title')}</strong><br>
            {t('note.details.desc')}
          </bento-note>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: c" data-trigger>
        <bento-layer
          style="padding: 2rem; display: flex; justify-content: center; align-items: center;"
        >
          <div
            style="width: 100%; height: 100%; background-color: var(--primary); -webkit-mask: url('/static/shai-logo.png') center / 50% no-repeat; mask: url('/static/shai-logo.png') center / 50% no-repeat;"
          ></div>
        </bento-layer>
        <bento-layer data-content>
          <a
            href="https://shaiscompany.com/"
            data-action
            target="_blank"
            rel="noopener noreferrer"
            title={t('title.company')}
            aria-label={t('title.company')}
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: d"></bento-cell>
      <bento-cell style="grid-area: e" data-trigger>
        <bento-layer>
          <EBackgroundDark
            data-theme-dark
            preserveAspectRatio="xMaxYMid slice"
          />
          <EBackgroundLight
            data-theme-light
            preserveAspectRatio="xMaxYMid slice"
          />
        </bento-layer>
        <bento-layer data-reveal>
          <EForegroundDark
            data-theme-dark
            preserveAspectRatio="xMaxYMid slice"
          />
          <EForegroundLight
            data-theme-light
            preserveAspectRatio="xMaxYMid slice"
          />
          <bento-note
            data-note="blog"
            data-tail="up"
            style="right: 15px; top: 45%; left: auto; bottom: auto; translate: none; max-width: 120px;"
            set:html={t('note.blog')}
          ></bento-note>
        </bento-layer>
        <bento-layer data-content>
          <bento-mark
            ><BookIcon
              aria-hidden="true"
              style="width: 4rem; height: 4rem; color: var(--foreground-l2);"
            /></bento-mark
          >
          <a
            href={lang === "en" ? "/en/blog" : "/blog"}
            data-action
            title={t('title.blog')}
            aria-label={t('title.blog')}
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: l" data-trigger>
        <bento-layer>
          <FBackgroundDark
            data-theme-dark
            preserveAspectRatio="xMinYMid slice"
          />
          <FBackgroundLight
            data-theme-light
            preserveAspectRatio="xMinYMid slice"
          />
        </bento-layer>
        <bento-layer data-reveal>
          <FForegroundDark
            data-theme-dark
            preserveAspectRatio="xMinYMid slice"
          />
          <FForegroundLight
            data-theme-light
            preserveAspectRatio="xMinYMid slice"
          />
          <bento-note
            data-note="blog"
            data-tail="down"
            style="left: 15px; top: 15px; right: auto; bottom: auto; translate: none; max-width: 120px; --tail-x: 20%;"
            set:html={t('note.work')}
          ></bento-note>
        </bento-layer>
        <bento-layer data-content>
          <bento-mark
            ><BriefcaseIcon
              aria-hidden="true"
              style="width: 4rem; height: 4rem; color: var(--foreground-l2);"
            /></bento-mark
          >
          <a
            href={lang === "en" ? "/en/work" : "/work"}
            data-action
            title={t('title.work')}
            aria-label={t('title.work')}
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: f" data-trigger data-cover>
        <bento-layer data-content>
          <GithubCalendar />
        </bento-layer>
        <bento-layer>
          <FBackgroundDark
            data-theme-dark
            preserveAspectRatio="xMinYMid slice"
          />
          <FBackgroundLight
            data-theme-light
            preserveAspectRatio="xMinYMid slice"
          />
        </bento-layer>
        <bento-layer data-reveal>
          <FForegroundDark
            data-theme-dark
            preserveAspectRatio="xMinYMid slice"
          />
          <FForegroundLight
            data-theme-light
            preserveAspectRatio="xMinYMid slice"
          />
          <bento-note
            data-note="calendar"
            data-tail="down"
            set:html={t('note.calendar')}
          />
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: g" data-trigger>
        <bento-layer>
          <GBackgroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMid slice"
          />
          <GBackgroundLight
            data-theme-light
            preserveAspectRatio="xMidYMid slice"
          />
        </bento-layer>
        <bento-layer data-reveal>
          <GForegroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMid slice"
          />
          <GForegroundLight
            data-theme-light
            preserveAspectRatio="xMidYMid slice"
          />
          <bento-note
            data-note="blog"
            data-tail="right"
            style="left: 15px; top: 50%; right: auto; bottom: auto; translate: 0 -50%; max-width: 120px;"
            set:html={t('note.linkedin')}
          ></bento-note>
        </bento-layer>
        <bento-layer data-content>
          <bento-mark
            ><LinkedinIcon
              aria-hidden="true"
              style="width: 4rem; height: 4rem; color: var(--foreground-l2);"
            /></bento-mark
          >
          <a
            href="https://linkedin.com/"
            data-action
            target="_blank"
            rel="noopener noreferrer"
            title={t('title.linkedin')}
            aria-label={t('title.linkedin')}
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: h">
        <bento-layer>
          <HImageDark data-theme-dark preserveAspectRatio="xMidYMid slice" />
          <HImageLight data-theme-light preserveAspectRatio="xMidYMid slice" />
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: i" data-trigger>
        <bento-layer>
          <IBackgroundDark
            data-theme-dark
            preserveAspectRatio="xMinYMax slice"
            style="width: 125%; margin-left: -25%;"
          />
          <IBackgroundLight
            data-theme-light
            preserveAspectRatio="xMinYMax slice"
            style="width: 125%; margin-left: -25%;"
          />
        </bento-layer>
        <bento-layer data-reveal>
          <IForegroundDark
            data-theme-dark
            preserveAspectRatio="xMinYMax slice"
            style="width: 125%; margin-left: -25%;"
          />
          <IForegroundLight
            data-theme-light
            preserveAspectRatio="xMinYMax slice"
            style="width: 125%; margin-left: -25%;"
          />
        </bento-layer>
        <bento-layer data-content>
          <bento-mark><GitHubIcon aria-hidden="true" /></bento-mark>
          <a
            href={githubHref}
            data-action
            target="_blank"
            rel="noopener noreferrer"
            title={t('title.github')}
            aria-label={t('title.github')}
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
      <bento-cell style="grid-area: j"></bento-cell>
      <bento-cell style="grid-area: k" data-trigger>
        <bento-layer>
          <KBackgroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMax slice"
            style="transform: scaleX(-1); width: 125%; margin-left: -25%;"
          />
          <KBackgroundLight
            data-theme-light
            preserveAspectRatio="xMidYMax slice"
            style="transform: scaleX(-1); width: 125%; margin-left: -25%;"
          />
        </bento-layer>
        <bento-layer data-reveal>
          <KForegroundDark
            data-theme-dark
            preserveAspectRatio="xMidYMax slice"
            style="transform: scaleX(-1); width: 125%; margin-left: -25%;"
          />
          <KForegroundLight
            data-theme-light
            preserveAspectRatio="xMidYMax slice"
            style="transform: scaleX(-1); width: 125%; margin-left: -25%;"
          />
          <bento-note
            data-note="blog"
            data-tail="left"
            style="right: 15px; top: 15px; left: auto; bottom: auto; translate: none; max-width: 120px;"
            set:html={t('note.x')}
          ></bento-note>
        </bento-layer>
        <bento-layer data-content>
          <bento-mark
            ><TwitterIcon
              aria-hidden="true"
              style="width: 4rem; height: 4rem; color: var(--foreground-l2);"
            /></bento-mark
          >
          <a
            href={twitterHref}
            data-action
            target="_blank"
            rel="noopener noreferrer"
            title={t('title.x')}
            aria-label={t('title.x')}
          >
            <ArrowUpRight aria-hidden="true" />
          </a>
        </bento-layer>
      </bento-cell>
    </bento-grid>
  </bento-container>
</Layout>

<style>
  @media (width >= 56rem) {
    :global(body) {
      overflow: hidden;
    }
  }

  bento-container {
    display: block;
    container-type: inline-size;
  }

  bento-grid {
    --bento-gap: var(--space-xs);

    display: grid;
    gap: var(--bento-gap);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "a" "b" "e" "l" "d" "g" "f" "j" "i" "k";

    @media (width < 30rem) {
      bento-cell {
        aspect-ratio: 1;
      }

      bento-cell:nth-of-type(1) {
        aspect-ratio: 3 / 4;
      }

      bento-cell:nth-of-type(4) {
        container-type: inline-size;
        aspect-ratio: auto;
      }

      bento-cell:nth-of-type(5) {
        aspect-ratio: 6 / 5;
      }

      bento-cell:nth-of-type(3),
      bento-cell:nth-of-type(9) {
        display: none;
      }
    }

    @media (width >= 30rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: calc((100cqw - var(--bento-gap)) / 2);
      grid-template-areas:
        "a a"
        "b d"
        "e l"
        "j g"
        "h i"
        "h c"
        "k c"
        "f f";
    }

    @media (width >= 56rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: min(calc((100cqw - 2 * var(--bento-gap)) / 3), 16vh);
      grid-template-areas:
        "a a b"
        "d e l"
        "h f f"
        "h i g"
        "k c j";
    }

    @media (width >= 80rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: min(calc((100cqw - 3 * var(--bento-gap)) / 4), 18vh);
      grid-template-areas:
        "a a b c"
        "d e l c"
        "h f f g"
        "h i j k";
    }
  }

  bento-cell {
    container-type: size;
    position: relative;
    display: block;
    overflow: hidden;
    border: 2px solid var(--border);
  }

  bento-layer {
    position: absolute;
    inset: 0;
    display: block;

    :global(svg),
    img {
      display: block;
      width: 100%;
      height: 100%;
    }

    img {
      object-fit: cover;
    }
  }

  bento-layer[data-mobile] {
    display: none;
  }

  @media (width < 30rem) {
    bento-layer[data-desktop] {
      display: none;
    }

    bento-layer[data-mobile] {
      display: block;
    }
  }

  bento-layer[data-reveal],
  bento-layer[data-overlay] {
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  @media (width >= 30rem) {
    bento-layer[data-reveal] {
      opacity: 0;
    }

    bento-cell[data-trigger]:hover bento-layer[data-reveal] {
      opacity: 1;
    }

    bento-grid:has(bento-cell[data-trigger]:hover) bento-layer[data-overlay] {
      opacity: 0;
    }
  }

  bento-layer[data-content] {
    pointer-events: none;

    a {
      pointer-events: auto;
    }
  }

  a[data-post-image] {
    position: absolute;
    inset: var(--space-xs);

    :global(img) {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      border: 2px solid var(--border);
    }

    @media (width >= 30rem) {
      inset: var(--space-s);
    }
  }

  bento-note {
    position: absolute;
    display: block;
    pointer-events: auto;
    padding: var(--space-3xs) var(--space-2xs);
    border: 2px solid var(--background-l4);
    background-color: var(--background);
    color: var(--prose-foreground);
    font-size: var(--note-text, clamp(0.8125rem, 4.5cqw, 1rem));
    line-height: calc(0.4rem + 1em);
    text-wrap: pretty;

    a {
      --underline: var(--muted-foreground);

      color: var(--foreground);
    }

    &[data-tail]::after {
      content: "";
      position: absolute;
      inline-size: 0.625rem;
      block-size: 0.625rem;
      rotate: 45deg;
      background-color: var(--background);
      border: 2px solid var(--background-l4);
    }

    &[data-tail="up"]::after {
      inset-block-start: calc(-0.3125rem - 1.5px);
      inset-inline-start: var(--tail-x, 50%);
      translate: -50% 0;
      border-inline-end: none;
      border-block-end: none;
    }

    &[data-tail="down"]::after {
      inset-block-end: calc(-0.3125rem - 1.5px);
      inset-inline-start: var(--tail-x, 50%);
      translate: -50% 0;
      border-inline-start: none;
      border-block-start: none;
    }

    &[data-tail="left"]::after {
      inset-inline-start: calc(-0.3125rem - 1.5px);
      inset-block-start: var(--tail-y, 50%);
      translate: 0 -50%;
      border-inline-end: none;
      border-block-start: none;
    }

    &[data-tail="right"]::after {
      inset-inline-end: calc(-0.3125rem - 1.5px);
      inset-block-start: var(--tail-y, 50%);
      translate: 0 -50%;
      border-inline-start: none;
      border-block-end: none;
    }
  }

  bento-note-stack {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    bento-note {
      --tail-y: 30%;

      position: relative;
      inset: auto;
    }
  }

  bento-note-stack[data-note="about"] {
    --note-text: clamp(0.8125rem, 2.25cqw, 1rem);

    inset-block-start: var(--space-s);
    inset-inline-end: clamp(1rem, 8%, 3rem);
    inline-size: min(58%, 26rem);

    bento-note {
      padding: clamp(0.5rem, 1.4cqw, 0.75rem);
    }
  }

  bento-layer[data-mobile] bento-note-stack[data-note="about"] {
    --note-text: clamp(0.9375rem, 4.5cqw, 1.1875rem);

    --tail-x: 20%;

    inset-inline: var(--space-xs);
    inset-block-start: var(--space-xs);
    inline-size: auto;

    bento-note {
      padding: clamp(0.5rem, 3cqw, 1rem);
    }
  }

  bento-note[data-note="details"] {
    --tail-y: 80%;

    inset-block-start: 65%;
    inset-inline-start: var(--space-m);
    translate: 0 -50%;
    max-inline-size: calc(100% - 7rem);
  }

  bento-note[data-note="blog"] {
    --note-text: clamp(0.8125rem, 2.25cqw, 1rem);

    --tail-x: 70%;

    inset-block-start: 48%;
    inset-inline-end: var(--space-xs);
    translate: 0 -50%;
  }

  bento-layer[data-mobile] bento-note[data-note="blog"] {
    inset-block-start: auto;
    inset-block-end: var(--space-xs);
    inset-inline: 4rem auto;
    translate: none;
  }

  bento-note[data-note="calendar"] {
    --note-text: clamp(0.8125rem, 2.25cqw, 1rem);
    --tail-x: 15%;

    inset-block-start: 30%;
    inset-inline-start: var(--space-xs);
    translate: 0 -50%;
  }

  bento-mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: light-dark(var(--background-l7), var(--primary));

    :global(svg) {
      width: 50%;
      height: 50%;
    }

    @media (width >= 30rem) {
      :global(svg) {
        width: 6rem;
        height: 6rem;
      }
    }
  }

  a[data-action] {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-2xs);
    padding: 0.75rem;
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--border) 50%, transparent);
    color: var(--primary);
    transition: box-shadow 0.3s ease;

    &:hover,
    &:focus-visible {
      box-shadow: 0 0 0 2px var(--ring);
    }

    :global(svg) {
      width: 1rem;
      height: 1rem;
      transition: transform 0.3s ease;
    }

    &:hover :global(svg) {
      transform: rotate(12deg);
    }
  }
</style>
