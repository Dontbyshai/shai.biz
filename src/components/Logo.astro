---
interface Props {
  size?: number
}
const { size = 26 } = Astro.props
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="8" class="logo-bg"></rect>
  <path class="logo-puy" d="M4.5 24.5 12 12.2c.6-1 1.6-1.1 2.4-.4l1.6 1.4 1.6-1.4c.8-.7 1.8-.6 2.4.4l7.5 12.3z"></path>
  <circle class="logo-sun" cx="23.5" cy="8.5" r="2"></circle>
</svg>

<style>
  .logo-bg {
    fill: var(--ink);
  }
  .logo-puy {
    fill: var(--accent);
    transform-origin: 16px 24px;
    transition: transform 0.5s var(--ease);
  }
  .logo-sun {
    fill: var(--bg);
    transition: transform 0.6s var(--ease);
  }
  :global(a:hover) .logo-puy {
    transform: scaleY(1.08);
  }
  :global(a:hover) .logo-sun {
    transform: translate(-3px, 2px);
  }
</style>
