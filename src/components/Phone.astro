---
/** iPhone-style frame around a real 1024×2222 (≈ 19.5:9) screenshot. No distortion: the screen keeps the image ratio. */
interface Props {
  src: string
  alt?: string
  width?: number
  height?: number
  class?: string
  loading?: "lazy" | "eager"
}
const { src, alt = "", width = 720, height = 1563, class: cls, loading = "lazy" } = Astro.props
---

<div class:list={["iphone", cls]} style={`--ratio:${width} / ${height}`}>
  <span class="btn b1" aria-hidden="true"></span>
  <span class="btn b2" aria-hidden="true"></span>
  <span class="btn b3" aria-hidden="true"></span>
  <div class="screen">
    <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
    <span class="island" aria-hidden="true"></span>
  </div>
</div>

<style>
  .iphone {
    position: relative;
    container-type: inline-size;
    padding: 3.4%;
    border-radius: 15.5% / 7.2%;
    background: linear-gradient(145deg, #3a3631, #121110 45%, #2a2723);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14),
      inset 0 0 0 4px #0b0a09,
      0 30px 60px -24px rgb(0 0 0 / 0.55),
      0 10px 22px -12px rgb(0 0 0 / 0.35);
  }
  .screen {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: 12.6% / 5.8%;
    overflow: hidden;
    background: #f7f7fb;
    isolation: isolate;
  }
  .screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(120deg, rgb(255 255 255 / 0.16), transparent 32%);
    pointer-events: none;
  }
  .island {
    position: absolute;
    top: 1.4%;
    left: 50%;
    width: 29%;
    aspect-ratio: 3.25;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #050505;
  }
  .btn {
    position: absolute;
    width: 1.2%;
    min-width: 2px;
    background: #24211e;
    border-radius: 2px;
  }
  .b1 {
    left: -0.9%;
    top: 17%;
    height: 4%;
  }
  .b2 {
    left: -0.9%;
    top: 24%;
    height: 7.5%;
  }
  .b3 {
    right: -0.9%;
    top: 26%;
    height: 10%;
  }
</style>
