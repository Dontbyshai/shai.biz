---
// Carte topographique de la Chaîne des Puys (relief simplifié, positions réelles des sommets).
---

<div class="topo-map">
  <svg class="map" viewBox="0 0 600 508" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="relief"><use href="/topo-puys.svg#map"></use></g>
    <g class="grid"><path class="gr" d="M88.9 0V508"></path><path class="gr" d="M200.0 0V508"></path><path class="gr" d="M311.1 0V508"></path><path class="gr" d="M422.2 0V508"></path><path class="gr" d="M533.3 0V508"></path><path class="gr" d="M0 428.6H600"></path><path class="gr" d="M0 301.6H600"></path><path class="gr" d="M0 174.6H600"></path><path class="gr" d="M0 47.6H600"></path><text class="tk" x="203.0" y="502">2.95°E</text><text class="tk" x="314.1" y="502">3.00°E</text><text class="tk" x="425.2" y="502">3.05°E</text><text class="tk" x="6" y="298.6">45.76°N</text><text class="tk" x="6" y="171.6">45.80°N</text></g>
    <path class="faille" d="M351 -5C360 127 342 254 360 381S354 513"></path>
    <text class="faille-t" transform="translate(367 183) rotate(83)">faille de Limagne</text>
    <g class="peaks"><g class="pk pk-main"><path d="M230.2 257.9l4.6 7.6h-9.2z"></path><text x="238.2" y="263.9" text-anchor="start">Dôme<tspan x="238.2" dy="11">1465 m</tspan></text></g><g class="pk"><path d="M245.8 184.5l4.6 7.6h-9.2z"></path><text x="253.8" y="190.5" text-anchor="start">Pariou<tspan x="253.8" dy="11">1209 m</tspan></text></g><g class="pk"><path d="M164.2 160.7l4.6 7.6h-9.2z"></path><text x="172.2" y="166.7" text-anchor="start">Côme<tspan x="172.2" dy="11">1253 m</tspan></text></g><g class="pk pk-minor"><path d="M224.7 102.6l4.6 7.6h-9.2z"></path><text x="232.7" y="108.6" text-anchor="start">Grand Sarcoui<tspan x="232.7" dy="11">1147 m</tspan></text></g><g class="pk pk-minor"><path d="M225.3 54.1l4.6 7.6h-9.2z"></path><text x="233.3" y="60.1" text-anchor="start">Louchadière<tspan x="233.3" dy="11">1200 m</tspan></text></g><g class="pk pk-minor"><path d="M216.0 352.2l4.6 7.6h-9.2z"></path><text x="224.0" y="358.2" text-anchor="start">Laschamp<tspan x="224.0" dy="11">1263 m</tspan></text></g><g class="pk pk-minor"><path d="M119.8 464.3l4.6 7.6h-9.2z"></path><text x="127.8" y="470.3" text-anchor="start">Lassolas<tspan x="127.8" dy="11">1187 m</tspan></text></g><g class="pk"><path d="M403.8 337.3l4.6 7.6h-9.2z"></path><text x="395.8" y="343.3" text-anchor="end">Gravenoire<tspan x="395.8" dy="11">820 m</tspan></text></g></g>
    <g class="city">
      <circle class="ring" cx="504.4" cy="247.0" r="16"></circle>
      <circle class="pin" cx="504.4" cy="247.0" r="5.5"></circle>
      <text x="492.4" y="233.0" text-anchor="end">Clermont-Ferrand</text>
    </g>
    <g class="north" transform="translate(566 34)">
      <circle r="15"></circle>
      <path d="M0 -10l5 13-5-3-5 3z"></path>
      <text y="-19" text-anchor="middle">N</text>
    </g>
    <g class="scale" transform="translate(22 40)">
      <path d="M0 0h28.6v-5M0 0v-5M57.2 0v-5"></path>
      <path class="sc-fill" d="M0 0h28.6"></path>
      <path d="M28.6 0h28.6"></path>
      <text x="57.2" y="-9" text-anchor="end">2 km</text>
    </g>
  </svg>
</div>

<style>
  .topo-map {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--tile-2);
  }
  .map {
    width: 100%;
    height: 100%;
    transition: transform 1.4s var(--ease);
    transform-origin: 40% 45%;
  }
  :global(.tile:hover) .map {
    transform: scale(1.05);
  }
  .relief {
    color: var(--topo-line);
  }
  .gr {
    stroke: var(--line-strong);
    stroke-width: 0.6;
    stroke-dasharray: 2 4;
    opacity: 0.8;
  }
  .tk {
    font: 500 8.5px var(--font-mono);
    fill: var(--muted);
    opacity: 0.85;
  }
  .faille {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-dasharray: 6 4;
    opacity: 0.55;
  }
  .faille-t {
    font: italic 400 11px var(--font-serif);
    fill: var(--accent-ink);
    opacity: 0.8;
    letter-spacing: 0.04em;
  }
  .pk path {
    fill: var(--ink);
  }
  .pk text {
    font: 500 10.5px var(--font-sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--tile-2);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .pk tspan {
    font: 400 8.5px var(--font-mono);
    fill: var(--muted);
  }
  .pk-main path {
    fill: var(--accent);
  }
  .pk-main text {
    font-size: 13px;
    font-weight: 600;
  }
  .city .pin {
    fill: var(--accent);
    stroke: var(--tile);
    stroke-width: 2.5;
  }
  .city .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: radar 2.8s var(--ease) infinite;
  }
  .city text {
    font: 600 11px var(--font-sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--tile-2);
    stroke-width: 3px;
  }
  .north circle {
    fill: color-mix(in srgb, var(--tile) 85%, transparent);
    stroke: var(--line-strong);
  }
  .north path {
    fill: var(--ink);
  }
  .north text,
  .scale text {
    font: 600 8.5px var(--font-mono);
    fill: var(--ink-2);
  }
  .scale path {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.2;
  }
  .scale .sc-fill {
    stroke-width: 3.5;
  }
  @keyframes radar {
    from { transform: scale(0.35); opacity: 1; }
    to { transform: scale(1.7); opacity: 0; }
  }
  @container topo (max-width: 420px) {
    .pk-minor, .tk, .faille-t { display: none; }
  }
</style>
