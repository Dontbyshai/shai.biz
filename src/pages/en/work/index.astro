---
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const allProjects = (await getCollection("projects", ({ data }) => data.lang === "en")).sort(
  (a, b) =>
    (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
    (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
)

const openSourceProjects = allProjects.filter((p) => p.data.type === "open-source" || !p.data.type)
const privateProjects = allProjects.filter((p) => p.data.type === "private")
---

<Layout>
  <MetaPage slot="head" title="Work" />
  
  <section>
    <h2>Open Source</h2>
    <ul>
      {openSourceProjects.map((project) => <ProjectCard project={project} />)}
    </ul>
  </section>

  {privateProjects.length > 0 && (
    <section>
      <h2>Private Projects</h2>
      <ul>
        {privateProjects.map((project) => <ProjectCard project={project} />)}
      </ul>
    </section>
  )}
</Layout>

<style>
  section {
    margin-block-end: var(--space-xl);
  }

  h2 {
    font-size: var(--step-2);
    margin-block-end: var(--space-m);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2xs);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
