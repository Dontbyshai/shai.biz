---
import Base from "@/layouts/Base.astro"
import { t } from "@/i18n/ui"
---

<Base locale="fr" title={t("fr", "notFoundTitle")} description={t("fr", "notFoundText")} pathname="/404/">
  <div class="wrap">
    <h1>{t("fr", "notFoundTitle")}</h1>
    <p class="lede">{t("fr", "notFoundText")}</p>
    <p><a href="/">{t("fr", "notFoundHome")}</a></p>
    <p lang="en">
      {t("en", "notFoundText")} <a href="/en/">{t("en", "notFoundHome")}</a>
    </p>
  </div>
</Base>
