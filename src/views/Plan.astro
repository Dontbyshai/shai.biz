---
import Flag from "@/components/Flag.astro"
import Icon from "@/components/Icon.astro"
import Logo from "@/components/Logo.astro"
import Base from "@/layouts/Base.astro"
import { companies, personalProjects, type Company, type GroupProject } from "@/data/group"
import type { Locale } from "@/data/types"
import { t } from "@/i18n/ui"
import { localizedPath } from "@/lib/paths"

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const L = (p: string) => localizedPath(locale, p)
const fr = locale === "fr"
const companyProjects = companies.reduce((n, c) => n + c.projects.length, 0)
const host = (href: string) => new URL(href).hostname.replace(/^www\./, "")
const projectHref = (p: GroupProject) => (p.slug ? L(`/blog/${p.slug}/`) : (p.href ?? "#"))

const groupName = "Shai Company Group"
const founder = "Shaï Chomette-Dugat"

const companySummary = (c: Company) => `${c.country[locale]} · ${c.owners[locale]}`
---

<Base locale={locale} path="/plan/" title={t(locale, "planTitle")} description={t(locale, "planLede")}>
  <header class="page-head rise" style="--i:0">
    <p class="eyebrow">shai.biz / plan</p>
    <h1 class="display">{t(locale, "planTitle")}</h1>
    <p class="lede">{t(locale, "planLede")}</p>
  </header>

  <ul class="stats mono rise" style="--i:1">
    <li><strong>{companies.length}</strong> {fr ? "sociétés" : "companies"}</li>
    <li><strong>{companyProjects}</strong> {fr ? "projets en société" : "company projects"}</li>
    <li><strong>{personalProjects.length}</strong> {fr ? "projets open source perso" : "personal open-source projects"}</li>
  </ul>

  <div class="stage rise" style="--i:2" data-stage>
    <div class="toolbar">
      <p class="hint mono">{t(locale, "planHint")}</p>
    </div>

    <div class="board">
      <div
        class="viewport"
        data-viewport
        tabindex="0"
        role="group"
        aria-label={t(locale, "planChart")}
      >
        <div class="zoom" role="group" aria-label={fr ? "Zoom de l'organigramme" : "Chart zoom"}>
          <button type="button" class="z-btn" data-zoom-out aria-label={t(locale, "planZoomOut")}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10" /></svg>
          </button>
          <button type="button" class="z-btn z-reset" data-zoom-reset aria-label={t(locale, "planZoomReset")}>
            <span data-zoom-label>100%</span>
          </button>
          <button type="button" class="z-btn" data-zoom-in aria-label={t(locale, "planZoomIn")}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
          </button>
        </div>
        <div class="world" data-world>
          <div class="me-slot">
            <button
              type="button"
              class="node me"
              data-node="me"
              aria-pressed="false"
              aria-controls="plan-panel"
            >
              <span class="me-mark" aria-hidden="true"><Logo size={26} /></span>
              <span class="root-txt">
                <span class="n-name">{founder}</span>
                <span class="n-sub">@Dontbyshai</span>
              </span>
            </button>
            <div class="me-fork" aria-hidden="true">
              <span class="spine wire" data-path="group ltd llc fr oss"></span>
              <span class="bus me-bus">
                <span class="bus-seg wire" data-path="group ltd llc fr"></span>
                <span class="bus-seg wire wire-dash" data-path="oss"></span>
              </span>
            </div>
          </div>

          <div class="group-col" data-branch="group">
            <div class="group-stem wire" data-path="group ltd llc fr" aria-hidden="true"></div>
            <div class="group-card">
              <button
                type="button"
                class="node root"
                data-node="group"
                aria-pressed="false"
                aria-controls="plan-panel"
              >
                <img
                  class="group-logo"
                  src="/images/shai-company-logo.png"
                  alt=""
                  width="40"
                  height="27"
                />
                <span class="root-txt">
                  <span class="n-name">{groupName}</span>
                  <span class="n-sub">{t(locale, "planGroupSub")}</span>
                </span>
              </button>
              <a class="n-site mono" href="https://shaiscompany.com" rel="noopener">
                <Icon name="globe" size={13} />
                shaiscompany.com
              </a>
            </div>
            <div class="fork" aria-hidden="true">
              <span class="spine wire" data-path="ltd llc fr"></span>
              <span class="bus">
                <span class="bus-seg wire" data-path="ltd llc"></span>
                <span class="bus-seg wire" data-path="llc fr"></span>
              </span>
            </div>

          <div class="row">
            {
              companies.map((c) => (
                <div class="branch" data-branch={c.id}>
                  <div class:list={["stem", "wire", { part: c.share < 100 }]} data-path={c.id} aria-hidden="true">
                    <span class:list={["share", "mono", { part: c.share < 100 }]} title={c.owners[locale]}>
                      {c.share}&nbsp;%
                    </span>
                  </div>
                  <button
                    type="button"
                    class="node co"
                    data-node={`co-${c.id}`}
                    aria-pressed="false"
                    aria-controls="plan-panel"
                  >
                    <span class="n-head">
                      <span class="n-badge" aria-hidden="true">
                        <Flag code={c.flag} size={20} />
                      </span>
                      <span class="n-txt">
                        <span class="n-name">{c.name}</span>
                        <span class="n-sub">{c.role[locale]}</span>
                      </span>
                    </span>
                    <span class="n-meta">{companySummary(c)}</span>
                  </button>
                  <ul class="pjs">
                    {c.projects.map((p) => (
                      <li class="pj">
                        <a class="pj-main" href={projectHref(p)}>
                          {p.icon ? (
                            <img
                              class:list={["pj-ic", { pixel: p.pixel, dark: p.dark }]}
                              src={p.icon}
                              alt=""
                              width="26"
                              height="26"
                              loading="lazy"
                            />
                          ) : (
                            <span class="pj-ic pj-snow" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="14" height="14">
                                <path d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7M12 2l-2.2 2.2M12 2l2.2 2.2M12 22l-2.2-2.2M12 22l2.2-2.2" />
                              </svg>
                            </span>
                          )}
                          <span class="pj-name">{p.name}</span>
                          <Icon name="arrow" size={12} class="pj-go" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          </div>

          <aside class="oss-col" data-branch="oss">
            <div class="oss-stem wire wire-dash" data-path="oss" aria-hidden="true"></div>
            <p class="oss-kicker mono">{t(locale, "planOssKicker")}</p>
            <div class="oss-wrap">
              <button
                type="button"
                class="node oss-head"
                data-node="oss"
                aria-pressed="false"
                aria-controls="plan-panel"
              >
                <span class="n-badge oss-badge" aria-hidden="true"><Icon name="github" size={15} /></span>
                <span class="n-txt">
                  <span class="n-name">{t(locale, "planOssTitle")}</span>
                  <span class="n-sub">{t(locale, "planOssSub")}</span>
                </span>
              </button>
              <ul class="pjs">
                {
                  personalProjects.map((p) => (
                    <li class="pj">
                      <a class="pj-main" href={projectHref(p)}>
                        {p.icon ? (
                          <img
                            class:list={["pj-ic", { pixel: p.pixel, dark: p.dark }]}
                            src={p.icon}
                            alt=""
                            width="26"
                            height="26"
                            loading="lazy"
                          />
                        ) : (
                          <span class="pj-ic pj-mono" aria-hidden="true">
                            {p.name.slice(0, 2)}
                          </span>
                        )}
                        <span class="pj-name">{p.name}</span>
                        <Icon name="arrow" size={12} class="pj-go" />
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a class="n-foot mono" href={L("/work/")}>
                {t(locale, "planSeeWork")} <Icon name="arrow" size={12} />
              </a>
            </div>
          </aside>
        </div>
      </div>

      <aside class="panel" id="plan-panel" data-panel aria-live="polite">
        <div class="panel-body" data-panel-body></div>
      </aside>
    </div>
  </div>

  <p class="note rise" style="--i:3">
    {
      fr
        ? "Ce plan montre qui porte quel projet et la part que je détiens dans chaque société. Les autres infos légales ne sont pas publiées ici."
        : "This map shows which entity runs which project and the share I own in each company. Other legal details are not published here."
    }
  </p>

  <template data-for="me">
    <div class="p-main">
      <p class="p-kicker mono">@Dontbyshai</p>
      <h3 class="p-title">{founder}</h3>
      <p class="p-lead">{t(locale, "planMeLead")}</p>
    </div>
  </template>

  <template data-for="group">
    <div class="p-main">
      <p class="p-kicker mono">{t(locale, "planGroupSub")}</p>
      <h3 class="p-title">{groupName}</h3>
      <a class="p-work mono" href="https://shaiscompany.com" rel="noopener">
        shaiscompany.com
      </a>
    </div>
    <ul class="p-list">
      {
        companies.map((c) => (
          <li>
            <strong>{c.name}</strong>
            <span>
              {c.country[locale]} · {c.owners[locale]}
            </span>
          </li>
        ))
      }
    </ul>
  </template>

  {
    companies.map((c) => (
      <template data-for={`co-${c.id}`}>
        <div class="p-main">
          <p class="p-kicker mono">{c.role[locale]}</p>
          <h3 class="p-title">{c.name}</h3>
          <dl class="p-facts">
            <dt>{t(locale, "planCountry")}</dt>
            <dd>{c.country[locale]}</dd>
            {c.kind && (
              <>
                <dt>{t(locale, "planKind")}</dt>
                <dd>{c.kind[locale]}</dd>
              </>
            )}
            <dt>{t(locale, "planOwners")}</dt>
            <dd>{c.owners[locale]}</dd>
          </dl>
        </div>
        <div class="p-side">
        <p class="p-kicker mono p-proj-k">{t(locale, "planProjects")}</p>
        <ul class="p-pjs">
          {c.projects.map((p) => (
            <li>
              <a href={projectHref(p)}>
                {p.icon ? (
                  <img
                    class:list={["pj-ic", { pixel: p.pixel, dark: p.dark }]}
                    src={p.icon}
                    alt=""
                    width="26"
                    height="26"
                    loading="lazy"
                  />
                ) : (
                  <span class="pj-ic pj-snow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14">
                      <path d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7M12 2l-2.2 2.2M12 2l2.2 2.2M12 22l-2.2-2.2M12 22l2.2-2.2" />
                    </svg>
                  </span>
                )}
                <span>
                  <strong>{p.name}</strong>
                  <span class="p-note">{p.note[locale]}</span>
                </span>
              </a>
              {p.href && (
                <a class="p-site mono" href={p.href} rel="noopener">
                  {host(p.href)}
                </a>
              )}
            </li>
          ))}
        </ul>
        </div>
      </template>
    ))
  }

  <template data-for="oss">
    <div class="p-main">
      <p class="p-kicker mono">{t(locale, "planOssKicker")}</p>
      <h3 class="p-title">{t(locale, "planOssTitle")}</h3>
      <p class="p-lead">{t(locale, "planOssSub")}</p>
      <a class="p-work mono" href={L("/work/")}>
        {t(locale, "planSeeWork")} <Icon name="arrow" size={12} />
      </a>
    </div>
    <ul class="p-pjs">
      {
        personalProjects.map((p) => (
          <li>
            <a href={projectHref(p)}>
              {p.icon ? (
                <img
                  class:list={["pj-ic", { pixel: p.pixel, dark: p.dark }]}
                  src={p.icon}
                  alt=""
                  width="26"
                  height="26"
                  loading="lazy"
                />
              ) : (
                <span class="pj-ic pj-mono" aria-hidden="true">
                  {p.name.slice(0, 2)}
                </span>
              )}
              <span>
                <strong>{p.name}</strong>
                <span class="p-note">{p.note[locale]}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </template>
</Base>

<script>
  const MIN = 0.2
  const MAX = 2.2
  const STEP = 1.18

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const compact = window.matchMedia("(max-width: 900px)")

  function clamp(n: number, a: number, b: number) {
    return Math.min(b, Math.max(a, n))
  }

  for (const stage of document.querySelectorAll<HTMLElement>("[data-stage]")) {
    const viewport = stage.querySelector<HTMLElement>("[data-viewport]")
    const world = stage.querySelector<HTMLElement>("[data-world]")
    const panelBody = stage.querySelector<HTMLElement>("[data-panel-body]")
    const label = stage.querySelector<HTMLElement>("[data-zoom-label]")
    if (!viewport || !world || !panelBody) continue

    let scale = 1
    let x = 0
    let y = 0
    let pinned: string | null = null
    let dragging = false
    let moved = false
    let px = 0
    let py = 0
    let pointers = new Map<number, { x: number; y: number }>()
    let pinch = 0
    let pinchScale = 1

    const templates = new Map<string, HTMLTemplateElement>()
    for (const tpl of document.querySelectorAll<HTMLTemplateElement>("template[data-for]")) {
      templates.set(tpl.dataset.for ?? "", tpl)
    }

    const show = (id: string) => {
      const tpl = templates.get(id)
      if (!tpl) return
      panelBody.replaceChildren(tpl.content.cloneNode(true))
    }

    const setHot = (id: string | null, press: boolean) => {
      const branch = id?.startsWith("co-") ? id.slice(3) : id
      stage.dataset.hot = branch ?? ""
      if (!branch) delete stage.dataset.hot
      for (const btn of stage.querySelectorAll<HTMLElement>("[data-node]")) {
        const on = btn.dataset.node === id
        btn.classList.toggle("is-hot", on)
        if (btn.hasAttribute("aria-pressed")) btn.setAttribute("aria-pressed", String(press && on))
      }
      for (const el of stage.querySelectorAll<HTMLElement>("[data-branch]")) {
        const on =
          el.dataset.branch === branch ||
          branch === "me" ||
          (branch === "group" && el.dataset.branch !== "oss")
        el.classList.toggle("is-hot", on)
      }
      if (id) show(id)
      else show("me")
    }

    const apply = (animate = false) => {
      world.classList.toggle("is-anim", Boolean(animate) && !reduced)
      world.style.transform = `translate(${x}px, ${y}px) scale(${scale})`
      if (label) label.textContent = `${Math.round(scale * 100)}%`
    }

    const zoomTo = (next: number, cx: number, cy: number, animate = false) => {
      const s = clamp(next, MIN, MAX)
      const wx = (cx - x) / scale
      const wy = (cy - y) / scale
      scale = s
      x = cx - wx * scale
      y = cy - wy * scale
      apply(animate)
    }

    const fit = (animate = false) => {
      const pad = compact.matches ? 12 : 20
      const vw = viewport.clientWidth - pad * 2
      const vh = viewport.clientHeight - pad * 2
      const ww = world.offsetWidth
      const wh = world.offsetHeight
      if (vw <= 0 || vh <= 0 || ww <= 0 || wh <= 0) return
      const needsShrink = ww > viewport.clientWidth + 0.5 || wh > viewport.clientHeight + 0.5
      if (needsShrink) {
        scale = clamp(Math.min(vw / ww, vh / wh, 1), MIN, 1)
        x = (viewport.clientWidth - ww * scale) / 2
        y = (viewport.clientHeight - wh * scale) / 2
      } else {
        scale = 1
        x = 0
        y = Math.max(pad / 2, (viewport.clientHeight - wh) / 2)
      }
      apply(animate)
    }

    const targetOf = (el: EventTarget | null) => {
      const node = (el as HTMLElement | null)?.closest?.<HTMLElement>("[data-node]")
      if (node?.dataset.node) return node.dataset.node
      const branch = (el as HTMLElement | null)?.closest?.<HTMLElement>("[data-branch]")
      if (!branch?.dataset.branch) return null
      return branch.dataset.branch === "oss" ? "oss" : `co-${branch.dataset.branch}`
    }

    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)")
    stage.addEventListener("pointerenter", (e) => {
      if (pinned || !canHover.matches) return
      const id = targetOf(e.target)
      if (id) setHot(id, false)
    }, true)

    stage.addEventListener("pointerleave", (e) => {
      if (pinned) return
      const next = targetOf(e.relatedTarget)
      if (!next) setHot(null, false)
    }, true)

    stage.addEventListener("click", (e) => {
      const el = e.target as HTMLElement | null
      if (el?.closest?.("a, .zoom")) return
      const id = targetOf(e.target)
      if (!id) {
        pinned = null
        setHot(null, false)
        return
      }
      if (pinned === id) {
        pinned = null
        setHot(null, false)
      } else {
        pinned = id
        setHot(id, true)
      }
    })

    stage.addEventListener("focusin", (e) => {
      const id = targetOf(e.target)
      if (id && !pinned) setHot(id, false)
    })

    stage.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        pinned = null
        setHot(null, false)
        return
      }
      const inView = viewport.contains(e.target as Node) || e.target === viewport
      if (!inView) return
      const cx = viewport.clientWidth / 2
      const cy = viewport.clientHeight / 2
      const pan = 48
      if (e.key === "+" || e.key === "=") {
        e.preventDefault()
        zoomTo(scale * STEP, cx, cy, true)
      } else if (e.key === "-" || e.key === "_") {
        e.preventDefault()
        zoomTo(scale / STEP, cx, cy, true)
      } else if (e.key === "0") {
        e.preventDefault()
        fit(true)
      } else if (e.key === "ArrowLeft" && e.target === viewport) {
        e.preventDefault()
        x += pan
        apply(true)
      } else if (e.key === "ArrowRight" && e.target === viewport) {
        e.preventDefault()
        x -= pan
        apply(true)
      } else if (e.key === "ArrowUp" && e.target === viewport) {
        e.preventDefault()
        y += pan
        apply(true)
      } else if (e.key === "ArrowDown" && e.target === viewport) {
        e.preventDefault()
        y -= pan
        apply(true)
      }
    })

    stage.querySelector("[data-zoom-in]")?.addEventListener("click", (e) => {
      e.stopPropagation()
      zoomTo(scale * STEP, viewport.clientWidth / 2, viewport.clientHeight / 2, true)
    })
    stage.querySelector("[data-zoom-out]")?.addEventListener("click", (e) => {
      e.stopPropagation()
      zoomTo(scale / STEP, viewport.clientWidth / 2, viewport.clientHeight / 2, true)
    })
    stage.querySelector("[data-zoom-reset]")?.addEventListener("click", (e) => {
      e.stopPropagation()
      fit(true)
    })

    viewport.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault()
        const rect = viewport.getBoundingClientRect()
        const factor = Math.exp(-e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.0018))
        zoomTo(scale * factor, e.clientX - rect.left, e.clientY - rect.top)
      },
      { passive: false },
    )

    const onDown = (e: PointerEvent) => {
      if ((e.target as HTMLElement).closest("a, button.z-btn")) return
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()]
        pinch = Math.hypot(a.x - b.x, a.y - b.y)
        pinchScale = scale
        dragging = false
        return
      }
      dragging = true
      moved = false
      px = e.clientX
      py = e.clientY
      viewport.setPointerCapture(e.pointerId)
      viewport.classList.add("is-grabbing")
    }

    const onMove = (e: PointerEvent) => {
      if (pointers.has(e.pointerId)) pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })
      if (pointers.size === 2 && pinch) {
        const [a, b] = [...pointers.values()]
        const d = Math.hypot(a.x - b.x, a.y - b.y)
        const rect = viewport.getBoundingClientRect()
        zoomTo(pinchScale * (d / pinch), (a.x + b.x) / 2 - rect.left, (a.y + b.y) / 2 - rect.top)
        return
      }
      if (!dragging) return
      const dx = e.clientX - px
      const dy = e.clientY - py
      if (!moved && Math.hypot(dx, dy) < 4) return
      moved = true
      x += dx
      y += dy
      px = e.clientX
      py = e.clientY
      apply(false)
    }

    const onUp = (e: PointerEvent) => {
      pointers.delete(e.pointerId)
      if (pointers.size < 2) pinch = 0
      if (!dragging) return
      dragging = false
      viewport.classList.remove("is-grabbing")
      if (moved) e.preventDefault()
    }

    viewport.addEventListener("pointerdown", onDown)
    viewport.addEventListener("pointermove", onMove)
    viewport.addEventListener("pointerup", onUp)
    viewport.addEventListener("pointercancel", onUp)
    viewport.addEventListener(
      "lostpointercapture",
      () => {
        dragging = false
        viewport.classList.remove("is-grabbing")
      },
    )

    // Un clic-glisser ne doit pas pin une carte
    viewport.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.stopPropagation()
          moved = false
        }
      },
      true,
    )

    const ro = new ResizeObserver(() => fit(false))
    ro.observe(viewport)
    compact.addEventListener("change", () => fit(false))
    document.fonts?.ready.then(() => fit(false))
    show("me")
    fit(false)
    requestAnimationFrame(() => fit(false))
  }
</script>

<style>
  .lede {
    margin-top: 16px;
    max-width: 60ch;
    color: var(--ink-2);
    font-size: 16.5px;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stats li {
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--tile);
    color: var(--ink-2);
    font-size: 12.5px;
  }
  .stats strong {
    color: var(--accent-ink);
    font-weight: 600;
    margin-right: 2px;
  }

  .stage {
    --wire: color-mix(in srgb, var(--accent) 48%, var(--line-strong));
    --wire-hot: var(--accent);
    --wire-w: 2px;
