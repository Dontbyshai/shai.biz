---
import Icon from "@/components/Icon.astro"
import Scene from "@/components/Scene.astro"
import Base from "@/layouts/Base.astro"
import type { Locale } from "@/data/types"
import { languages, languageColor } from "@/data/work"
import { t } from "@/i18n/ui"
import { localizedPath } from "@/lib/paths"
import { postsNewestFirst } from "@/lib/posts"
import { renderInline } from "@/lib/text"

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const L = (p: string) => localizedPath(locale, p)
const posts = postsNewestFirst()
const latest = posts.slice(0, 3)

const monthNames =
  locale === "fr"
    ? ["janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc."]
    : ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
const months = monthNames.map((name, i) => {
  const key = `2026-${String(i + 1).padStart(2, "0")}`
  const items = posts.filter((p) => p.date.startsWith(key))
  return { name, key, items }
})
const total2026 = months.reduce((n, m) => n + m.items.length, 0)
const rows = 7

const short = (iso: string) =>
  new Intl.DateTimeFormat(locale === "fr" ? "fr-FR" : "en-GB", { day: "2-digit", month: "short" })
    .format(new Date(`${iso}T12:00:00Z`))
    .replace(".", "")

const flakes = Array.from({ length: 26 }, (_, i) => ({
  x: (i * 37) % 100,
  d: 6 + ((i * 13) % 9),
  delay: -((i * 7) % 11),
  s: 2 + (i % 3),
}))
const status = {
  night: t(locale, "statusNight"),
  morning: t(locale, "statusMorning"),
  afternoon: t(locale, "statusAfternoon"),
  evening: t(locale, "statusEvening"),
}
---

<Base locale={locale} path="/">
  <h1 class="sr-only">Shaï Chomette-Dugat</h1>
  <div class="bento">
    <section class="tile intro rise" style="--i:0">
      <div class="intro-art"><Scene /></div>
      <div class="bubble">
        <p set:html={renderInline(t(locale, "hello"), locale)} />
        <p class="more" set:html={renderInline(t(locale, "helloMore"), locale)} />
      </div>
    </section>

    <section class="tile clock rise" style="--i:1" data-clock data-status={JSON.stringify(status)} data-locale={locale}>
      <p class="eyebrow">{t(locale, "localTime")}</p>
      <p class="time" aria-live="off"><span data-h>--</span><span class="colon">:</span><span data-m>--</span></p>
      <div class="clock-foot">
        <p class="mono">{t(locale, "city")} · <span data-off>UTC+1</span></p>
        <p class="status"><span class="dot live"></span><span data-status-text>{status.evening}</span></p>
      </div>
    </section>

    <a class="tile nn rise" style="--i:2" href={L("/blog/notianote-app-store/")}>
      <div class="nn-head">
        <img src="/images/notianote-icon.webp" alt="" width="56" height="56" loading="eager" />
        <span class="chip"><span class="dot"></span>{t(locale, "flagship")}</span>
      </div>
      <h2 class="display">NotiaNote</h2>
      <p class="nn-text">{t(locale, "notianoteText")}</p>
      <p class="mono nn-meta">{t(locale, "notianoteMeta")}</p>
      <div class="phone" aria-hidden="true">
        <img src="/images/notianote-accueil.webp" alt="" width="390" height="844" loading="lazy" />
      </div>
      <span class="go"><Icon name="arrow" size={16} /></span>
    </a>

    <section class="tile prof rise" style="--i:3">
      <div class="avatar" aria-hidden="true">S</div>
      <div>
        <p class="prof-name">Shaï Chomette-Dugat</p>
        <p class="mono prof-handle">@Dontbyshai</p>
      </div>
      <p class="prof-role">{t(locale, "profileRole")}</p>
      <p class="prof-now"><span class="dot live"></span>{t(locale, "profileNow")}</p>
    </section>

    <section class="tile latest rise" style="--i:4">
      <div class="tile-top">
        <p class="eyebrow">{t(locale, "latest")}</p>
        <a class="mono more-link" href={L("/blog/")}>{t(locale, "allPosts")} <Icon name="arrow" size={13} /></a>
      </div>
      <ol>
        {
          latest.map((post) => (
            <li>
              <a href={L(`/blog/${post.slug}/`)}>
                <time class="mono" datetime={post.date}>{short(post.date)}</time>
                <span class="latest-title">{post.title[locale]}</span>
                <Icon name="arrow" size={14} class="latest-arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="tile topo rise" style="--i:5">
      <div class="topo-lines" aria-hidden="true"></div>
      <div class="pin" aria-hidden="true"><span></span></div>
      <div class="topo-label">
        <p class="mono">45.78° N · 3.08° E</p>
        <p class="topo-name">{t(locale, "mapCaption")}</p>
      </div>
    </section>

    <section class="tile rel rise" style="--i:6">
      <div class="tile-top">
        <p class="eyebrow">{t(locale, "releases")}</p>
        <p class="mono rel-total"><strong>{total2026}</strong> {t(locale, "releasesNote")}</p>
      </div>
      <div class="months">
        {
          months.map((m, mi) => (
            <div class:list={["month", { now: mi === 10 }]} title={m.items.map((p) => p.title[locale]).join(" · ") || m.name}>
              <div class="cells">
                {Array.from({ length: rows }, (_, r) => (
                  <span
                    class:list={["cell", { on: r < m.items.length }]}
                    style={r < m.items.length ? `--d:${mi * 40 + r * 30}ms` : undefined}
                  />
                ))}
              </div>
              <span class="mono m-name">{m.name.slice(0, locale === "fr" ? 4 : 3).replace(".", "")}</span>
            </div>
          ))
        }
      </div>
    </section>

    <a class="tile ltl rise" style="--i:7" href={L("/blog/left-to-live-app-store/")}>
      <div class="ltl-head">
        <img src="/images/lefttolive-icon.webp" alt="" width="40" height="40" loading="lazy" />
        <div>
          <p class="ltl-name">Left To Live</p>
          <p class="mono ltl-meta">{t(locale, "leftMeta")}</p>
        </div>
      </div>
      <svg class="ecg" viewBox="0 0 200 50" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 30h46l6-4 5 4h12l5-24 7 40 6-16h20l7-6 6 6h35l5-22 7 38 6-16h27"></path>
      </svg>
      <p class="ltl-text">{t(locale, "leftText")}</p>
      <span class="go"><Icon name="arrow" size={16} /></span>
    </a>

    <a class="tile gh rise" style="--i:8" href="https://github.com/Dontbyshai" rel="me noopener">
      <Icon name="github" size={44} class="gh-logo" />
      <div class="gh-text">
        <p class="mono">@Dontbyshai</p>
        <p><strong>13</strong> <span>{t(locale, "reposPublic")}</span></p>
      </div>
      <span class="go"><Icon name="arrow" size={16} /></span>
    </a>

    <section class="tile lang rise" style="--i:9">
      <p class="eyebrow">{t(locale, "languages")}</p>
      <div class="bar" aria-hidden="true">
        {languages.map((l) => <span style={`flex:${l.share};background:${languageColor[l.name] ?? "var(--line-strong)"}`} />)}
      </div>
      <ul>
        {
          languages.slice(0, 4).map((l) => (
            <li>
              <span class="sw" style={`background:${languageColor[l.name]}`} />
              <span>{l.name}</span>
              <span class="mono pct">{l.share.toLocaleString(locale === "fr" ? "fr-FR" : "en-GB")} %</span>
            </li>
          ))
        }
      </ul>
    </section>

    <a class="tile spot rise" style="--i:10" href="https://open.spotify.com/intl-fr/artist/47Nz6g4SrrfU7kFEjpxP6k" rel="me noopener">
      <div class="eq" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <div>
        <p class="spot-title">{t(locale, "music")}</p>
        <p class="mono spot-meta"><Icon name="spotify" size={13} /> {t(locale, "listen")}</p>
      </div>
      <span class="go"><Icon name="arrow" size={16} /></span>
    </a>

    <a class="tile snow rise" style="--i:11" href={L("/blog/snowbound/")}>
      <div class="flakes" aria-hidden="true">
        {flakes.map((f) => <i style={`left:${f.x}%;--d:${f.d}s;--delay:${f.delay}s;--s:${f.s}px`} />)}
      </div>
      <span class="chip snow-chip"><span class="dot"></span>{t(locale, "soon")}</span>
      <h2 class="display snow-title">Snowbound</h2>
      <p class="snow-text">{t(locale, "snowText")}</p>
      <span class="go"><Icon name="arrow" size={16} /></span>
    </a>

    <a class="tile bx rise" style="--i:12" href="https://app.bitixe.com" rel="noopener">
      <img src="/images/bitixe-icon.webp" alt="" width="34" height="42" loading="lazy" />
      <svg class="spark" viewBox="0 0 120 40" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 32 L12 28 L22 30 L34 20 L44 24 L56 14 L66 18 L78 10 L90 15 L102 6 L120 9"></path>
      </svg>
      <div>
        <p class="bx-name">Bitixe</p>
        <p class="mono bx-meta">{t(locale, "bitixeText")}</p>
      </div>
      <span class="go"><Icon name="arrow" size={16} /></span>
    </a>

    <section class="tile else rise" style="--i:13">
      <p class="eyebrow">{t(locale, "elsewhere")}</p>
      <ul>
        <li><a href="https://twitter.com/Dontbyshai" rel="me noopener"><Icon name="x" size={14} /> X <Icon name="arrow" size={13} class="ea" /></a></li>
        <li><a href="https://www.linkedin.com/in/shai-chomette-dugat-276a542a0/" rel="me noopener"><Icon name="linkedin" size={14} /> LinkedIn <Icon name="arrow" size={13} class="ea" /></a></li>
        <li><a href="https://www.instagram.com/dontbyshai/" rel="me noopener"><Icon name="instagram" size={14} /> Instagram <Icon name="arrow" size={13} class="ea" /></a></li>
        <li><a href="mailto:dontbyshai@gmail.com"><Icon name="mail" size={14} /> E-mail <Icon name="arrow" size={13} class="ea" /></a></li>
      </ul>
    </section>
  </div>
</Base>

<script>
  const el = document.querySelector<HTMLElement>("[data-clock]")
  if (el) {
    const status = JSON.parse(el.dataset.status ?? "{}") as Record<string, string>
    const h = el.querySelector("[data-h]")!
    const m = el.querySelector("[data-m]")!
    const off = el.querySelector("[data-off]")!
    const st = el.querySelector("[data-status-text]")!
    const fmt = new Intl.DateTimeFormat("fr-FR", {
      timeZone: "Europe/Paris",
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZoneName: "shortOffset",
    })
    const tick = () => {
      const parts = Object.fromEntries(fmt.formatToParts(new Date()).map((p) => [p.type, p.value]))
      h.textContent = parts.hour
      m.textContent = parts.minute
      off.textContent = (parts.timeZoneName ?? "UTC+1").replace("GMT", "UTC")
      const hour = Number(parts.hour)
      const key = hour < 7 ? "night" : hour < 12 ? "morning" : hour < 17 ? "afternoon" : hour < 23 ? "evening" : "night"
      st.textContent = status[key]
    }
    tick()
    setInterval(tick, 10_000)
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 192px;
    gap: 12px;
    grid-template-areas:
      "intro intro clock nn"
      "prof latest latest nn"
      "topo rel rel ltl"
      "topo gh lang spot"
      "snow snow bx else";
  }
  .tile {
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  /* Intro */
  .intro {
    grid-area: intro;
    padding: 0;
  }
  .intro-art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .bubble {
    margin: 18px 18px 0 auto;
    width: min(62%, 330px);
    background: color-mix(in srgb, var(--tile) 92%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 12px 12px 12px 4px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
    box-shadow: var(--shadow);
  }
  .bubble :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .bubble .more {
    margin-top: 6px;
    color: var(--muted);
  }
  .bubble :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Horloge */
  .clock {
    grid-area: clock;
  }
  .time {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 14px;
    font-variant-numeric: tabular-nums;
    font-variation-settings: "opsz" 72;
  }
  .colon {
    color: var(--accent);
    animation: colon 2s steps(1) infinite;
    padding: 0 1px;
  }
  @keyframes colon {
    50% {
      opacity: 0.2;
    }
  }
  .clock-foot {
    margin-top: auto;
    display: grid;
    gap: 4px;
    color: var(--muted);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-2);
  }

  /* NotiaNote */
  .nn {
    grid-area: nn;
    background:
      radial-gradient(120% 70% at 100% 0%, color-mix(in srgb, #6d5cff 12%, transparent), transparent 60%),
      var(--tile);
  }
  .nn-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nn-head img {
    border-radius: 13px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .nn h2 {
    font-size: 34px;
    margin-top: 16px;
  }
  .nn-text {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 13.5px;
  }
  .nn-meta {
    margin-top: 8px;
    color: var(--muted);
  }
  .phone {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: -150px;
    height: 230px;
    border-radius: 22px 22px 0 0;
    border: 6px solid var(--ink);
    border-bottom: 0;
    overflow: hidden;
    background: #fff;
    transform: translateY(8px) rotate(-2deg);
    transition: transform 0.6s var(--ease);
    z-index: -1;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.5);
  }
  .phone img {
    width: 100%;
    height: auto;
  }
  .nn:hover .phone {
    transform: translateY(-14px) rotate(0deg);
  }

  /* Profil */
  .prof {
    grid-area: prof;
    gap: 10px;
  }
  .avatar {
    width: 46px;
    height: 46px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 26px;
    box-shadow: inset 0 -6px 12px rgb(0 0 0 / 0.15);
  }
  .prof-name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .prof-handle,
  .prof-role {
    color: var(--muted);
  }
  .prof-role {
    font-size: 13px;
  }
  .prof-now {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-2);
  }

  /* Derniers articles */
  .latest {
    grid-area: latest;
  }
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
    transition: color 0.2s;
  }
  .more-link:hover {
    color: var(--accent-ink);
  }
  .latest ol {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
  }
  .latest li + li {
    border-top: 1px dashed var(--line);
  }
  .latest li a {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 9px 2px;
  }
  .latest time {
    color: var(--muted);
  }
  .latest-title {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s;
  }
  .latest :global(.latest-arrow) {
    color: var(--muted);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity 0.2s,
      transform 0.3s var(--ease);
  }
  .latest li a:hover .latest-title {
    color: var(--accent-ink);
  }
  .latest li a:hover :global(.latest-arrow) {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }

  /* Topo */
  .topo {
    grid-area: topo;
    padding: 0;
    background: var(--tile-2);
  }
  .topo-lines {
    position: absolute;
    inset: -10px;
    background: var(--line-strong);
    -webkit-mask: url("/topo.svg") center / cover no-repeat;
    mask: url("/topo.svg") center / cover no-repeat;
    opacity: 0.9;
    transition: transform 1.2s var(--ease);
  }
  .topo:hover .topo-lines {
    transform: scale(1.06) rotate(-1deg);
  }
  .pin {
    position: absolute;
    left: 52%;
    top: 44%;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--accent);
    border: 3px solid var(--tile);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .pin span {
    position: absolute;
    inset: -12px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    animation: radar 2.8s var(--ease) infinite;
  }
  @keyframes radar {
    from {
      transform: scale(0.3);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  .topo-label {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--tile) 88%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .topo-label .mono {
    color: var(--muted);
    font-size: 11px;
  }
  .topo-name {
    font-family: var(--font-serif);
    font-size: 19px;
    margin-top: 2px;
  }

  /* Sorties 2026 */
  .rel {
    grid-area: rel;
  }
  .rel-total {
    color: var(--muted);
  }
  .rel-total strong {
    color: var(--accent-ink);
    font-weight: 600;
  }
  .months {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 6px;
  }
  .month {
    display: grid;
    gap: 6px;
    justify-items: center;
  }
  .cells {
    display: flex;
    flex-direction: column-reverse;
    gap: 3px;
    width: 100%;
    align-items: center;
  }
  .cell {
    width: 100%;
    max-width: 22px;
    aspect-ratio: 1.6;
    border-radius: 3px;
    background: var(--tile-2);
    border: 1px solid var(--line);
  }
  .cell.on {
    background: var(--accent);
    border-color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cell.on {
      animation: pop 0.5s var(--ease) both;
      animation-delay: calc(var(--d) + 400ms);
    }
    @keyframes pop {
      from {
        transform: scale(0.2);
        opacity: 0;
      }
    }
  }
  .cell.on:nth-child(even) {
    background: color-mix(in srgb, var(--accent) 78%, var(--tile));
  }
  .m-name {
    font-size: 10.5px;
    color: var(--muted);
    text-transform: lowercase;
  }
  .month.now .m-name {
    color: var(--accent-ink);
    font-weight: 600;
  }

  /* Left To Live */
  .ltl {
    grid-area: ltl;
  }
  .ltl-head {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .ltl-head img {
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .ltl-name {
    font-weight: 600;
    font-size: 14px;
  }
  .ltl-meta {
    color: var(--muted);
    font-size: 11px;
  }
  .ecg {
    width: 100%;
    height: 44px;
    margin: 12px 0 8px;
  }
  .ecg path {
    fill: none;
    stroke: #e0312b;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    animation: beat 2.6s linear infinite;
  }
  @keyframes beat {
    to {
      stroke-dashoffset: -340;
    }
  }
  .ltl-text {
    font-size: 13px;
    color: var(--ink-2);
    padding-right: 36px;
  }

  /* GitHub */
  .gh {
    grid-area: gh;
    justify-content: space-between;
  }
  .gh :global(.gh-logo) {
    color: var(--ink);
    transition: transform 0.5s var(--ease);
  }
  .gh:hover :global(.gh-logo) {
    transform: rotate(-8deg) scale(1.05);
  }
  .gh-text .mono {
    color: var(--muted);
  }
  .gh-text p:last-child {
    font-size: 14px;
  }
  .gh-text strong {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 400;
    margin-right: 2px;
  }

