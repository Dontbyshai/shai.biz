---
import Base from "@/layouts/Base.astro"
import { annexes, workGroups } from "@/data/work"
import type { Locale } from "@/data/types"
import { t } from "@/i18n/ui"
import { localizedPath } from "@/lib/paths"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<Base locale={locale} title={t(locale, "workTitle")} description={t(locale, "workLede")} pathname="/work/">
  <div class="wrap">
    <h1>{t(locale, "workTitle")}</h1>
    <p class="lede">{t(locale, "workLede")}</p>

    {
      workGroups.map((group) => (
        <section class="work-block">
          <h2>{group.title[locale]}</h2>
          <ul class="rule-list">
            {group.items.map((item) => (
              <li class="work-item">
                <div class="work-top">
                  <h3>{item.name}</h3>
                  <span class="status">{item.status[locale]}</span>
                </div>
                <p class="work-summary">{item.summary[locale]}</p>
                {item.stack && <p class="meta-line">{item.stack}</p>}
                {item.license && (
                  <p class="meta-line">
                    {locale === "fr" ? "Licence" : "License"} : {item.license[locale]}
                  </p>
                )}
                <ul class="work-links">
                  {item.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label[locale]}</a>
                    </li>
                  ))}
                  {item.blogSlug && (
                    <li>
                      <a href={localizedPath(locale, `/blog/${item.blogSlug}/`)}>{t(locale, "readArticle")}</a>
                    </li>
                  )}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="work-block">
      <h2>{t(locale, "annexTitle")}</h2>
      <p class="lede">{t(locale, "annexLede")}</p>
      <ul class="rule-list">
        {
          annexes.map((item) => (
            <li class="work-item">
              <div class="work-top">
                <h3>{item.name}</h3>
              </div>
              <p class="work-summary">{item.text[locale]}</p>
              <ul class="work-links">
                <li>
                  <a href={item.href}>GitHub</a>
                </li>
                {item.blogSlug && (
                  <li>
                    <a href={localizedPath(locale, `/blog/${item.blogSlug}/`)}>{t(locale, "readArticle")}</a>
                  </li>
                )}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
